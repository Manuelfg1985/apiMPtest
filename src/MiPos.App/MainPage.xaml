<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiPos.App.MainPage"
             BackgroundColor="#F4F6F9"
             Title="Mi POS">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15" VerticalOptions="Center">

            <!-- Card de Pantalla / Monto -->
            <Border Stroke="#009ee3"
                    StrokeThickness="2"
                    BackgroundColor="White"
                    Padding="15"
                    Margin="0,10,0,10">
                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12"/>
                </Border.StrokeShape>
                <VerticalStackLayout Spacing="5">
                    <Label Text="Monto a Cobrar"
                           FontSize="14"
                           TextColor="#666666"
                           HorizontalOptions="Center" />
                    
                    <Label x:Name="LblMonto"
                           Text="$ 0,00"
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="#009ee3"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>
            </Border>

            <!-- Campo de Email del Cliente -->
            <VerticalStackLayout Spacing="5">
                <Label Text="Email del cliente (para comprobante):"
                       FontSize="13"
                       TextColor="#333333" />
                <Entry x:Name="TxtEmail"
                       Placeholder="cliente@ejemplo.com"
                       Keyboard="Email"
                       Text=""
                       ClearButtonVisibility="WhileEditing" />
            </VerticalStackLayout>

            <!-- Teclado Numérico POS -->
            <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                  ColumnDefinitions="*,*,*"
                  ColumnSpacing="10"
                  RowSpacing="10"
                  Margin="0,10,0,10">

                <!-- Fila 1 -->
                <Button Grid.Row="0" Grid.Column="0" Text="1" Clicked="OnNumeroClicked" BackgroundColor="White" TextColor="#333" FontSize="24" FontAttributes="Bold" CornerRadius="8" HeightRequest="60"/>
                <Button Grid.Row="0" Grid.Column="1" Text="2" Clicked="OnNumeroClicked" BackgroundColor="White" TextColor="#333" FontSize="24" FontAttributes="Bold" CornerRadius="8" HeightRequest="60"/>
                <Button Grid.Row="0" Grid.Column="2" Text="3" Clicked="OnNumeroClicked" BackgroundColor="White" TextColor="#333" FontSize="24" FontAttributes="Bold" CornerRadius="8" HeightRequest="60"/>

                <!-- Fila 2 -->
                <Button Grid.Row="1" Grid.Column="0" Text="4" Clicked="OnNumeroClicked" BackgroundColor="White" TextColor="#333" FontSize="24" FontAttributes="Bold" CornerRadius="8" HeightRequest="60"/>
                <Button Grid.Row="1" Grid.Column="1" Text="5" Clicked="OnNumeroClicked" BackgroundColor="White" TextColor="#333" FontSize="24" FontAttributes="Bold" CornerRadius="8" HeightRequest="60"/>
                <Button Grid.Row="1" Grid.Column="2" Text="6" Clicked="OnNumeroClicked" BackgroundColor="White" TextColor="#333" FontSize="24" FontAttributes="Bold" CornerRadius="8" HeightRequest="60"/>

                <!-- Fila 3 -->
                <Button Grid.Row="2" Grid.Column="0" Text="7" Clicked="OnNumeroClicked" BackgroundColor="White" TextColor="#333" FontSize="24" FontAttributes="Bold" CornerRadius="8" HeightRequest="60"/>
                <Button Grid.Row="2" Grid.Column="1" Text="8" Clicked="OnNumeroClicked" BackgroundColor="White" TextColor="#333" FontSize="24" FontAttributes="Bold" CornerRadius="8" HeightRequest="60"/>
                <Button Grid.Row="2" Grid.Column="2" Text="9" Clicked="OnNumeroClicked" BackgroundColor="White" TextColor="#333" FontSize="24" FontAttributes="Bold" CornerRadius="8" HeightRequest="60"/>

                <!-- Fila 4 -->
                <Button Grid.Row="3" Grid.Column="0" Text="C" Clicked="OnBorrarClicked" BackgroundColor="#E74C3C" TextColor="White" FontSize="20" FontAttributes="Bold" CornerRadius="8" HeightRequest="60"/>
                <Button Grid.Row="3" Grid.Column="1" Text="0" Clicked="OnNumeroClicked" BackgroundColor="White" TextColor="#333" FontSize="24" FontAttributes="Bold" CornerRadius="8" HeightRequest="60"/>
                <Button Grid.Row="3" Grid.Column="2" Text="00" Clicked="OnNumeroClicked" BackgroundColor="White" TextColor="#333" FontSize="24" FontAttributes="Bold" CornerRadius="8" HeightRequest="60"/>
            </Grid>

            <!-- Botón Cobrar -->
            <Button Text="Generar Cobro QR"
                    Clicked="OnCobrarClicked"
                    BackgroundColor="#009ee3"
                    TextColor="White"
                    FontSize="18"
                    FontAttributes="Bold"
                    HeightRequest="55"
                    CornerRadius="10" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>