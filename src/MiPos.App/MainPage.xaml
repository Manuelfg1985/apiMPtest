<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="MiPos.App.MainPage"
             BackgroundColor="#F5F5F7"
             Title="Mi POS - Cobrar">

    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="20" HorizontalOptions="Center" MaximumWidthRequest="400">

            <Label Text="Ingresar Monto"
                   FontSize="18"
                   TextColor="#666666"
                   HorizontalOptions="Center" />

            <!-- Display de Monto -->
            <Frame HasShadow="True" CornerRadius="12" Padding="15" BackgroundColor="White">
                <Label x:Name="LblMonto"
                       Text="$ 0,00"
                       FontSize="36"
                       FontAttributes="Bold"
                       TextColor="#2E7D32"
                       HorizontalOptions="Center" />
            </Frame>

            <!-- Input de Email del cliente -->
            <Entry x:Name="TxtEmail"
                   Placeholder="Email del cliente (Opcional)"
                   Keyboard="Email"
                   ClearButtonVisibility="WhileEditing" />

            <!-- Teclado Numérico -->
            <Grid RowDefinitions="*,*,*,*" ColumnDefinitions="*,*,*" RowSpacing="10" ColumnSpacing="10">
                <Button Text="1" Grid.Row="0" Grid.Column="0" Clicked="OnNumeroClicked" Style="{StaticResource KeyPadBtn}"/>
                <Button Text="2" Grid.Row="0" Grid.Column="1" Clicked="OnNumeroClicked" Style="{StaticResource KeyPadBtn}"/>
                <Button Text="3" Grid.Row="0" Grid.Column="2" Clicked="OnNumeroClicked" Style="{StaticResource KeyPadBtn}"/>

                <Button Text="4" Grid.Row="1" Grid.Column="0" Clicked="OnNumeroClicked" Style="{StaticResource KeyPadBtn}"/>
                <Button Text="5" Grid.Row="1" Grid.Column="1" Clicked="OnNumeroClicked" Style="{StaticResource KeyPadBtn}"/>
                <Button Text="6" Grid.Row="1" Grid.Column="2" Clicked="OnNumeroClicked" Style="{StaticResource KeyPadBtn}"/>

                <Button Text="7" Grid.Row="2" Grid.Column="0" Clicked="OnNumeroClicked" Style="{StaticResource KeyPadBtn}"/>
                <Button Text="8" Grid.Row="2" Grid.Column="1" Clicked="OnNumeroClicked" Style="{StaticResource KeyPadBtn}"/>
                <Button Text="9" Grid.Row="2" Grid.Column="2" Clicked="OnNumeroClicked" Style="{StaticResource KeyPadBtn}"/>

                <Button Text="C" Grid.Row="3" Grid.Column="0" Clicked="OnBorrarClicked" BackgroundColor="#E53935" TextColor="White" FontSize="20" FontAttributes="Bold"/>
                <Button Text="0" Grid.Row="3" Grid.Column="1" Clicked="OnNumeroClicked" Style="{StaticResource KeyPadBtn}"/>
                <Button Text="00" Grid.Row="3" Grid.Column="2" Clicked="OnNumeroClicked" Style="{StaticResource KeyPadBtn}"/>
            </Grid>

            <!-- Botón de Generar Cobro -->
            <Button x:Name="BtnCobrar"
                    Text="GENERAR COBRO QR"
                    BackgroundColor="#009EE3"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="18"
                    HeightRequest="55"
                    CornerRadius="10"
                    Clicked="OnCobrarClicked" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>